<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#EEF3F9</Color>
    <Color x:Key="SidebarBackgroundColor">#F8FAFD</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="SurfaceRaisedColor">#E9F0F8</Color>
    <Color x:Key="InputBackgroundColor">#F5F8FC</Color>
    <Color x:Key="BorderColor">#B8C7DA</Color>
    <Color x:Key="TextPrimaryColor">#102039</Color>
    <Color x:Key="TextSecondaryColor">#53657F</Color>
    <Color x:Key="AccentColor">#2F6FE4</Color>
    <Color x:Key="AccentHoverColor">#245AC0</Color>
    <Color x:Key="AccentSoftColor">#DFEAFE</Color>
    <Color x:Key="SuccessColor">#128142</Color>
    <Color x:Key="SuccessSoftColor">#DFF5E8</Color>
    <Color x:Key="WarningColor">#A96000</Color>
    <Color x:Key="WarningSoftColor">#FFF0D2</Color>
    <Color x:Key="DangerColor">#C8263B</Color>
    <Color x:Key="DangerSoftColor">#FCE3E7</Color>
    <Color x:Key="OverlayColor">#22000000</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>
