<Window x:Class="CrewChiefRUAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CrewChief RU Assistant"
        Width="1240"
        Height="820"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="26"
                            Height="26"
                            CornerRadius="8"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="CC"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CrewChief RU"
                               Margin="10,0,0,0"
                               FontWeight="SemiBold"
                               FontSize="13" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="WindowTitleText"
                           Text="Главная"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Content="—"
                            Click="Minimize_Click" />
                    <Button Style="{StaticResource TitleBarButtonStyle}"
                            Content="□"
                            Click="Maximize_Click" />
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            Content="×"
                            FontSize="20"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation rail -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,22,18,20">
                    <TextBlock Text="RU ASSISTANT"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Гоночный инженер"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                    <TextBlock Text="Локально. Быстро. Без облака."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="DashboardNav"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Selected"
                            Click="DashboardNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="18" Width="28" />
                            <TextBlock Text="Главная" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="VoiceNav"
                            Style="{StaticResource NavButtonStyle}"
                            Click="VoiceNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◉" FontSize="16" Width="28" />
                            <TextBlock Text="Голоса" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav"
                            Style="{StaticResource NavButtonStyle}"
                            Click="SettingsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="28" />
                            <TextBlock Text="Настройки" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LogsNav"
                            Style="{StaticResource NavButtonStyle}"
                            Click="LogsNav_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="≡" FontSize="18" Width="28" />
                            <TextBlock Text="Журнал" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="18,0,18,18">
                    <TextBlock Text="Тема интерфейса"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="2,0,0,7" />
                    <ComboBox x:Name="ThemeCombo"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Системная" Tag="System" />
                        <ComboBoxItem Content="Светлая" Tag="Light" />
                        <ComboBoxItem Content="Тёмная" Tag="Dark" />
                    </ComboBox>
                    <Border Style="{StaticResource CompactCardStyle}"
                            Margin="0,14,0,0"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Версия 0.9.4"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="WPF desktop edition"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              ClipToBounds="True">

            <!-- Dashboard -->
            <ScrollViewer x:Name="DashboardPage">
                <StackPanel Margin="28,24,28,30">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Готов к работе"
                                       Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="Запусти помощник и получай ответы по телеметрии прямо во время заезда."
                                       Style="{StaticResource MutedTextStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="StartButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Запустить"
                                    Click="StartButton_Click" />
                            <Button x:Name="StopButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Остановить"
                                    Margin="10,0,0,0"
                                    IsEnabled="False"
                                    Click="StopButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,18"
                            Padding="24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Радиоканал"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="Bold"
                                           FontSize="12" />
                                <TextBlock x:Name="HeroStatusText"
                                           Text="Ассистент остановлен"
                                           FontSize="26"
                                           FontWeight="SemiBold"
                                           Margin="0,8,0,4" />
                                <TextBlock x:Name="HeroSubtitleText"
                                           Text="Нажми «Запустить», когда CrewChief и игра готовы."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Grid Grid.Column="1"
                                  Width="116"
                                  Height="116"
                                  Margin="26,0,0,0">
                                <Ellipse Fill="{DynamicResource AccentSoftBrush}" />
                                <Ellipse x:Name="ListeningPulse"
                                         Width="72"
                                         Height="72"
                                         Fill="{DynamicResource AccentBrush}"
                                         Opacity="0.18" />
                                <Ellipse Width="44"
                                         Height="44"
                                         Fill="{DynamicResource AccentBrush}" />
                                <TextBlock Text="●"
                                           Foreground="White"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <UniformGrid Columns="4" Margin="0,0,0,18">
                        <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Состояние" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="StateText" Text="Остановлен" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="MQTT" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="MqttText" Text="0 сообщений" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Память" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="MemoryText" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CompactCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Активный голос" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock x:Name="ActiveVoiceText" Text="Eugene" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.12*" />
                            <ColumnDefinition Width="0.88*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Быстрое подключение" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Основные устройства и кнопка разговора"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,18" />

                                <TextBlock Text="Микрофон" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                                <ComboBox x:Name="MicrophoneCombo" />

                                <TextBlock Text="Кнопка разговора" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BindingText" IsReadOnly="True" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Content="Назначить"
                                            Margin="10,0,0,0"
                                            Click="BindButton_Click" />
                                </Grid>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="Порт MQTT" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                                        <TextBox x:Name="MqttPortBox" Text="1883" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Громкость" Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:0}%}"
                                                       Foreground="{DynamicResource AccentHoverBrush}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Grid>
                                        <Slider x:Name="VolumeSlider"
                                                Style="{StaticResource ModernSliderStyle}"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="85"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Последний радиообмен" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Последняя распознанная команда и ответ инженера"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,18" />

                                <TextBlock Text="Вопрос" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,7,0,16"
                                        MinHeight="78">
                                    <TextBlock x:Name="LastQuestionText"
                                               Text="Команды ещё не было"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>

                                <TextBlock Text="Ответ" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource InputBackgroundBrush}"
                                        CornerRadius="10"
                                        Padding="14"
                                        Margin="0,7,0,0"
                                        MinHeight="96">
                                    <TextBlock x:Name="LastAnswerText"
                                               Text="Здесь появится ответ ассистента"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Voices -->
            <ScrollViewer x:Name="VoicePage" Visibility="Collapsed">
                <StackPanel Margin="28,24,28,30">
                    <TextBlock Text="Голоса" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Выбери активного диктора и проверь установленные голосовые пакеты."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="EugeneCard" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="E" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Eugene" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="Мужской голос" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" x:Name="EugeneStatusBadge" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,18,0,0">
                                    <TextBlock x:Name="EugeneStatusText" Text="Проверка…" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Text="Спокойный и уверенный тембр для лаконичных подсказок во время гонки."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,16,0,18" />
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PreviewEugeneButton"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Content="Прослушать"
                                            Click="PreviewEugeneButton_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="UseEugeneButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Использовать"
                                            Click="UseEugeneButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" x:Name="XeniaCard" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource AccentSoftBrush}">
                                        <TextBlock Text="X" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="Xenia" FontSize="22" FontWeight="SemiBold" />
                                        <TextBlock Text="Женский голос" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="1" x:Name="XeniaStatusBadge" Style="{StaticResource StatusChipStyle}" HorizontalAlignment="Left" Margin="0,18,0,0">
                                    <TextBlock x:Name="XeniaStatusText" Text="Проверка…" FontWeight="SemiBold" FontSize="12" />
                                </Border>
                                <TextBlock Grid.Row="2"
                                           Text="Чёткий женский тембр с тем же радиоэффектом и полным набором команд."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,16,0,18" />
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PreviewXeniaButton"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Content="Прослушать"
                                            Click="PreviewXeniaButton_Click" />
                                    <Button Grid.Column="2"
                                            x:Name="UseXeniaButton"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Content="Использовать"
                                            Click="UseXeniaButton_Click" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Управление голосовыми пакетами" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Открой установщик, чтобы добавить второй голос или удалить ненужный."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Изменить голоса"
                                    Margin="20,0,0,0"
                                    Click="ManageVoicesButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Settings -->
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                <StackPanel Margin="28,24,28,30">
                    <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Звук, поведение приложения и подключение CrewChief."
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,0,0,20" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Аудио" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Выход звука и озвучивание ответов"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,18" />

                                <TextBlock Text="Устройство вывода" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                                <ComboBox x:Name="PlaybackCombo" />

                                <CheckBox x:Name="SpeechEnabledToggle"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Озвучивать ответы с эффектом рации"
                                          Margin="0,20,0,0" />
                                <CheckBox x:Name="CrewChiefPriorityToggle"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Приоритет голоса CrewChief"
                                          Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Поведение" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Запуск, трей и оформление"
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,18" />

                                <CheckBox x:Name="MinimizeToTrayToggle"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Сворачивать приложение в трей" />

                                <TextBlock Text="Активный голос" Style="{StaticResource MutedTextStyle}" Margin="0,22,0,6" />
                                <ComboBox x:Name="VoiceCombo" SelectionChanged="VoiceCombo_SelectionChanged" />

                                <Button Style="{StaticResource ModernButtonStyle}"
                                        Content="Открыть папку данных"
                                        Margin="0,18,0,0"
                                        Click="OpenDataButton_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CrewChief" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Автоматическая настройка локальной MQTT-телеметрии."
                                           Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Content="Настроить CrewChief"
                                    Margin="20,0,0,0"
                                    Click="ConfigureCrewChiefButton_Click" />
                            <Button Grid.Column="2"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Content="Показать поля"
                                    Margin="10,0,0,0"
                                    Click="ShowFieldsButton_Click" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Logs -->
            <Grid x:Name="LogsPage" Visibility="Collapsed" Margin="28,24,28,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Журнал" Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Распознавание, телеметрия и диагностические сообщения."
                               Style="{StaticResource MutedTextStyle}" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CompactCardStyle}" Margin="0,20,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="ModelStatusText" Text="Проверка модели Vosk…" FontWeight="SemiBold" />
                            <ProgressBar x:Name="ModelProgress" Minimum="0" Maximum="100" Value="0" Margin="0,10,0,0" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                            <Button Style="{StaticResource ModernButtonStyle}"
                                    Content="Тестовые данные"
                                    Click="TestDataButton_Click" />
                            <Button Style="{StaticResource ModernButtonStyle}"
                                    Content="Очистить"
                                    Margin="8,0,0,0"
                                    Click="ClearLogButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                    <RichTextBox x:Name="LogBox"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="{DynamicResource InputBackgroundBrush}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Padding="18"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 VerticalScrollBarVisibility="Auto" />
                </Border>
            </Grid>

        </Grid>
    </Grid>
</Window>
