<Window x:Class="CrewChiefRUAssistant.InputBindingCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Назначение кнопки разговора"
        Width="660"
        Height="430"
        MinWidth="580"
        MinHeight="390"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Назначение кнопки разговора"
                           FontWeight="SemiBold"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="×"
                        FontSize="20"
                        HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="24">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel HorizontalAlignment="Center">
                        <Grid Width="110" Height="110" Margin="0,0,0,18">
                            <Ellipse x:Name="PulseRing"
                                     Fill="{DynamicResource AccentSoftBrush}"
                                     Opacity="0.5" />
                            <Ellipse Width="64"
                                     Height="64"
                                     Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Text="●"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Нажми нужную кнопку"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Поддерживаются клавиатура, мышь, кнопки руля или геймпада и направления POV."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center"
                                   MaxWidth="500"
                                   Margin="0,8,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="12"
                            Padding="14"
                            Margin="0,22,0,12">
                        <TextBlock x:Name="DevicesText"
                                   Text="Поиск контроллеров…"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>

                    <TextBlock Grid.Row="2"
                               x:Name="StatusText"
                               Text="Отпусти нажатые кнопки…"
                               Foreground="{DynamicResource AccentBrush}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />

                    <Button Grid.Row="3"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="Отмена"
                            HorizontalAlignment="Right"
                            Click="Cancel_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
