<Window x:Class="CrewChiefRUAssistant.Installer.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CrewChief RU Assistant Setup"
        Width="980"
        Height="670"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="CrewChief RU Assistant Setup"
                           FontWeight="SemiBold"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <ComboBox x:Name="ThemeCombo"
                              Width="128"
                              Margin="0,4,10,4"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Системная" />
                        <ComboBoxItem Content="Светлая" />
                        <ComboBoxItem Content="Тёмная" />
                    </ComboBox>
                    <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                            Content="×"
                            FontSize="20"
                            Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Brand panel -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <Border Width="62"
                            Height="62"
                            CornerRadius="20"
                            Background="{DynamicResource AccentBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="CC"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="CrewChief RU Assistant"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Margin="0,18,0,0" />
                    <TextBlock Text="Русский голосовой инженер для CrewChief"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border x:Name="StepOneIndicator" Style="{StaticResource CompactCardStyle}" Margin="0,0,0,10" Padding="14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="1" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Папка установки" FontWeight="SemiBold" />
                                <TextBlock Text="Куда установить программу" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StepTwoIndicator" Style="{StaticResource CompactCardStyle}" Margin="0,0,0,10" Padding="14" Opacity="0.55">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}">
                                <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Голоса" FontWeight="SemiBold" />
                                <TextBlock Text="Eugene, Xenia или оба" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border x:Name="StepThreeIndicator" Style="{StaticResource CompactCardStyle}" Padding="14" Opacity="0.55">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="10" Background="{DynamicResource SurfaceRaisedBrush}">
                                <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Параметры" FontWeight="SemiBold" />
                                <TextBlock Text="Ярлыки, автозапуск, CrewChief" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <TextBlock Text="Без прав администратора"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Версия 0.9.4 · WPF edition"
                               Style="{StaticResource MutedTextStyle}"
                               Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Wizard -->
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="76" />
            </Grid.RowDefinitions>

            <Grid x:Name="PageHost" Margin="34,28,34,18" ClipToBounds="True">
                <ScrollViewer x:Name="LocationPage">
                    <StackPanel>
                        <TextBlock x:Name="WelcomeTitle" Text="Добро пожаловать" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock x:Name="WelcomeSubtitle"
                                   Text="Установщик подготовит программу, русскую модель распознавания и выбранные голоса."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,24" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Папка установки" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Программа будет установлена только для текущего пользователя."
                                           Style="{StaticResource MutedTextStyle}"
                                           Margin="0,0,0,14" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathBox" />
                                    <Button Grid.Column="1"
                                            Style="{StaticResource ModernButtonStyle}"
                                            Content="Выбрать"
                                            Margin="10,0,0,0"
                                            Click="Browse_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="3" Margin="0,18,0,0">
                            <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Локально" FontWeight="SemiBold" />
                                    <TextBlock Text="Речь не отправляется в облако" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CompactCardStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Легко" FontWeight="SemiBold" />
                                    <TextBlock Text="Около 100 МБ памяти в работе" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CompactCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Автоматически" FontWeight="SemiBold" />
                                    <TextBlock Text="Настройка MQTT CrewChief" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="VoicesPage" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Выбери голоса" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Можно установить один голос или оба. Активный голос меняется в приложении."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,22" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="EugeneChoiceCard" Style="{StaticResource CardStyle}" Margin="0,0,10,0" MouseLeftButtonDown="EugeneCard_Click" Cursor="Hand">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="E" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                            <TextBlock Text="Eugene" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Мужской голос" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" x:Name="InstallEugeneCheck" IsChecked="True" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Спокойный и уверенный тембр с эффектом гоночной радиосвязи."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,18,0,12" />
                                    <TextBlock x:Name="EugeneInstalledText" Text="Статус: проверка…" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" x:Name="XeniaChoiceCard" Style="{StaticResource CardStyle}" Margin="10,0,0,0" MouseLeftButtonDown="XeniaCard_Click" Cursor="Hand">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="54" Height="54" CornerRadius="17" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="X" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                            <TextBlock Text="Xenia" FontSize="20" FontWeight="SemiBold" />
                                            <TextBlock Text="Женский голос" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" x:Name="InstallXeniaCheck" IsChecked="True" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Чёткий женский тембр с тем же набором команд и радиоэффектом."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,18,0,12" />
                                    <TextBlock x:Name="XeniaInstalledText" Text="Статус: проверка…" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Голос по умолчанию" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="Его можно будет поменять в приложении без переустановки."
                                               Style="{StaticResource MutedTextStyle}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1" x:Name="DefaultVoiceCombo" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="OptionsPage" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Почти готово" Style="{StaticResource PageTitleStyle}" />
                        <TextBlock Text="Проверь дополнительные параметры перед установкой."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,22" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <CheckBox x:Name="DesktopShortcutCheck"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Создать ярлык на рабочем столе"
                                          IsChecked="True" />
                                <CheckBox x:Name="ConfigureCrewChiefCheck"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Автоматически настроить телеметрию CrewChief"
                                          IsChecked="True"
                                          Margin="0,18,0,0" />
                                <CheckBox x:Name="AutoStartCheck"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Запускать помощник вместе с Windows"
                                          Margin="0,18,0,0" />
                                <CheckBox x:Name="LaunchAfterCheck"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          Content="Запустить приложение после установки"
                                          IsChecked="True"
                                          Margin="0,18,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CompactCardStyle}" Margin="0,18,0,0" Background="{DynamicResource AccentSoftBrush}">
                            <StackPanel>
                                <TextBlock Text="Готово к установке" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="SummaryText" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="ProgressPage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="500">
                        <Grid Width="120" Height="120" Margin="0,0,0,22">
                            <Ellipse Fill="{DynamicResource AccentSoftBrush}" />
                            <Ellipse x:Name="ProgressPulse" Width="78" Height="78" Fill="{DynamicResource AccentBrush}" Opacity="0.22" />
                            <TextBlock Text="↓" Foreground="White" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="Установка CrewChief RU Assistant"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="ProgressStatusText"
                                   Text="Подготовка…"
                                   Style="{StaticResource MutedTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,18" />
                        <ProgressBar x:Name="InstallProgressBar" Minimum="0" Maximum="100" Width="500" Height="10" />
                        <TextBlock x:Name="ProgressPercentText"
                                   Text="0%"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>
                </Grid>

                <Grid x:Name="CompletePage" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="520">
                        <Border Width="100" Height="100" CornerRadius="32" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,0,22">
                            <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Установка завершена"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock x:Name="CompleteSummaryText"
                                   TextAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,10,0,24" />
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Content="Открыть журнал установки"
                                Click="OpenLog_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <Border Grid.Row="1"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid Margin="26,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="OpenLogButton"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="Журнал"
                                Click="OpenLog_Click" />
                        <Button x:Name="RemoveButton"
                                Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить программу"
                                Margin="10,0,0,0"
                                Visibility="Collapsed"
                                Click="Remove_Click" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="BackButton"
                                Style="{StaticResource ModernButtonStyle}"
                                Content="Назад"
                                Visibility="Collapsed"
                                Click="Back_Click" />
                        <Button x:Name="NextButton"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Далее"
                                Margin="10,0,0,0"
                                Click="Next_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
