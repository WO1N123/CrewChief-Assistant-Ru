<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#070B14</Color>
    <Color x:Key="SidebarBackgroundColor">#0C1424</Color>
    <Color x:Key="SurfaceColor">#17243B</Color>
    <Color x:Key="SurfaceRaisedColor">#223453</Color>
    <Color x:Key="InputBackgroundColor">#0E192B</Color>
    <Color x:Key="BorderColor">#3C557C</Color>
    <Color x:Key="TextPrimaryColor">#F8FAFF</Color>
    <Color x:Key="TextSecondaryColor">#C4CEE0</Color>
    <Color x:Key="AccentColor">#5B8FFF</Color>
    <Color x:Key="AccentHoverColor">#7EA9FF</Color>
    <Color x:Key="AccentSoftColor">#203B6D</Color>
    <Color x:Key="SuccessColor">#4DE395</Color>
    <Color x:Key="SuccessSoftColor">#153D2B</Color>
    <Color x:Key="WarningColor">#FFC857</Color>
    <Color x:Key="WarningSoftColor">#4B3715</Color>
    <Color x:Key="DangerColor">#FF8297</Color>
    <Color x:Key="DangerSoftColor">#4D2230</Color>
    <Color x:Key="OverlayColor">#99000000</Color>

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />
</ResourceDictionary>
