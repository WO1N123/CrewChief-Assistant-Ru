<Window x:Class="CrewChiefRUAssistant.Installer.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Удаление CrewChief RU Assistant"
        Width="610"
        Height="430"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <TextBlock Text="Удаление CrewChief RU Assistant"
                           FontWeight="SemiBold"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center" />
                <Button Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="×"
                        FontSize="20"
                        HorizontalAlignment="Right"
                        Click="Cancel_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28">
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Width="70" Height="70" CornerRadius="22" Background="{DynamicResource DangerSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="×" FontSize="38" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0,18,0,0">
                        <TextBlock Text="Удалить программу?" FontSize="25" FontWeight="SemiBold" />
                        <TextBlock Text="Программа и ярлыки будут удалены. Настройки можно оставить для следующей установки."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                    <CheckBox Grid.Row="2"
                              x:Name="DeleteDataCheck"
                              Style="{StaticResource ToggleSwitchStyle}"
                              Content="Также удалить настройки, модель распознавания и все голоса"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernButtonStyle}"
                                Content="Отмена"
                                Click="Cancel_Click" />
                        <Button Style="{StaticResource DangerButtonStyle}"
                                Content="Удалить"
                                Margin="10,0,0,0"
                                Click="Remove_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
