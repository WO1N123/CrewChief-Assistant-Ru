<Window x:Class="CrewChiefRUAssistant.Installer.UninstallProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Удаление CrewChief RU Assistant"
        Width="590"
        Height="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrush}"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            CornerRadius="12"
                            GlassFrameThickness="0"
                            ResizeBorderThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <TextBlock Text="Удаление CrewChief RU Assistant"
                       FontWeight="SemiBold"
                       Margin="18,0,0,0"
                       VerticalAlignment="Center" />
        </Border>
        <Grid Grid.Row="1" Margin="28">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel VerticalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="…" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Удаление программы"
                               FontSize="24"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock x:Name="StatusText"
                               Text="Подготовка…"
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,18" />
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Height="10" />
                    <Button x:Name="CloseButton"
                            Style="{StaticResource ModernButtonStyle}"
                            Content="Закрыть"
                            HorizontalAlignment="Right"
                            Margin="0,22,0,0"
                            IsEnabled="False"
                            Click="Close_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
